@using EcommerceCandyHill.MVC.Models.Save
@model SaveProductViewModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Site</title>
</head>
<body>
    <div class="container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success">@TempData["Sucesso"]</div>
        }
        <form class="needs-validation" action="/Products/SaveProduct" method="post" novalidate>
            <div class="row">
                <div class="col-sm-8">
                    <label>Nome</label>
                    <input type="text" class="form-control @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="Name">
                    <div class="valid-feedback">
                        Dado válido!
                    </div>
                    <div class="invalid-feedback">
                        @Html.ValidationMessageFor(m => m.Name)
                    </div>
                </div>
                <div class="col-sm-4">
                    <label>Preço</label>
                    <input type="text" class="form-control @(ViewData.ModelState["Price"]?.Errors.Count > 0 ? "is-invalid" : "")" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="Price" step="any" />
                    <div class="invalid-feedback d-block">
                        @Html.ValidationMessageFor(m => m.Price)
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <label>EAN</label>
                    <input type="text" class="form-control @(ViewData.ModelState["EAN"]?.Errors.Count > 0 ? "is-invalid" : "")" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="EAN">
                    <div class="invalid-feedback">
                        @Html.ValidationMessageFor(m => m.EAN)
                    </div>
                </div>
                <div class="col-sm-4">
                    <label for="data" class="form-label">Escolha uma data:</label>
                    <input type="date" class="form-control  @(ViewData.ModelState["ExpirationDate"]?.Errors.Count > 0 ? "is-invalid" : "")" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="ExpirationDate">
                    <div class="invalid-feedback">
                        @Html.ValidationMessageFor(m => m.ExpirationDate)
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <label for="floatingTextarea">Descrição</label>
                    <textarea class="form-control" placeholder="Leave a comment here" id="floatingTextarea"></textarea>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Salvar</button>
        </form>
    </div>
</body>
</html>

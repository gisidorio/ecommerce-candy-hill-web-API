<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Site</title>
</head>
<body>
    <div class="container">
        <form action="/Product/Save" method="post">
            <div class="row">
                <div class="col-sm-8">
                    <label>Nome</label>
                    <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="Name">
                </div>
                <div class="col-sm-4">
                    <label>Preço</label>
                    <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="Price">
                </div>

            </div>
            <div class="row">
                <div class="col-sm-4">
                    <label>EAN</label>
                    <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" name="EAN">
                </div>
                <div class="col-sm-4">
                    <label for="data" class="form-label">Escolha uma data:</label>
                    <input type="date" class="form-control" id="data" name="ExpirationDate">
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <label for="floatingTextarea">Descrição</label>
                    <textarea class="form-control" placeholder="Leave a comment here" id="floatingTextarea"></textarea>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Salvar</button>
        </form>
    </div>

</body>
</html>
